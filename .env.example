# # ================================================================
# # SUSRUTA HOSPITAL WEBSITE - ENVIRONMENT CONFIGURATION (.env)
# # Copy this file to '.env' in the root folder and update the values.
# # ================================================================

# # --- DATABASE CONFIGURATION ---
# # PostgreSQL Connection URL
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/database_name

# # --- SERVER & PORT CONFIGURATION ---
# # Backend Server Port (Default: 5000)
# PORT=5000

# # Frontend Base URL Path (Default: /)
# BASE_PATH=/

# # Full Application URL
# APP_URL=http://localhost:5000

# # --- ADMIN CREDENTIALS ---
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=password123

# # --- LIVEKIT (TELECONSULTATION / VIDEO CALLS) ---
# LIVEKIT_URL=ws://localhost:7880
# LIVEKIT_API_KEY=devkey
# LIVEKIT_API_SECRET=secret

# # --- EMAIL / SMTP CONFIGURATION ---
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@gmail.com
# SMTP_PASS=your_app_password
# SMTP_FROM_EMAIL=noreply@susrutahospital.com

# # --- SECURITY ---
# UNSUBSCRIBE_SECRET=susruta-unsub-hmac-2024

# # --- GOOGLE OAUTH (OPTIONAL) ---
# GOOGLE_CLIENT_ID=your_google_client_id
# GOOGLE_CLIENT_SECRET=your_google_client_secret
